rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidPropertySubmission(data, submissionId) {
      return data.keys().hasAll([
        'id', 'publicPortfolioId', 'ownerName', 'ownerMobile', 'ownerCountryCode',
        'propertyName', 'location', 'fullAddress', 'googleMapUrl', 'reraNumber',
        'willingTo', 'targetCategory', 'propertyType', 'societyType', 'propertyStatus',
        'possessionDate', 'configuration', 'doorFacing', 'floorNumber', 'towerNumber',
        'totalAcres', 'amenities', 'furnishing', 'others', 'photos', 'video',
        'submissionStatus', 'isDeleted', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'publicPortfolioId', 'dedupKey', 'ownerName', 'ownerMobile', 'ownerCountryCode',
        'propertyName', 'location', 'fullAddress', 'googleMapUrl', 'reraNumber',
        'willingTo', 'sellerType', 'rentPerMonth', 'maintenance', 'advance', 'availableFrom',
        'targetCategory', 'propertyType', 'societyType', 'expectedPrice', 'propertyStatus',
        'possessionDate', 'configuration', 'doorFacing', 'floorNumber', 'towerNumber',
        'totalAcres', 'amenities', 'furnishing', 'others', 'photos', 'video',
        'submissionStatus', 'reviewNotes', 'reviewedBy', 'reviewedAt', 'isDeleted',
        'deletedAt', 'createdAt', 'updatedAt'
      ]) &&
      data.id == submissionId &&
      data.publicPortfolioId is string && data.publicPortfolioId.size() <= 128 &&
      data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 120 &&
      data.ownerMobile is string && data.ownerMobile.size() >= 8 && data.ownerMobile.size() <= 20 &&
      data.ownerCountryCode is string && data.ownerCountryCode.size() <= 8 &&
      data.propertyName is string && data.propertyName.size() >= 2 && data.propertyName.size() <= 200 &&
      data.location is string && data.location.size() >= 2 && data.location.size() <= 200 &&
      data.fullAddress is string && data.fullAddress.size() <= 1000 &&
      data.googleMapUrl is string && data.googleMapUrl.size() <= 1000 &&
      data.reraNumber is string && data.reraNumber.size() <= 150 &&
      data.willingTo in ['Sell', 'Rental'] &&
      ((data.willingTo == 'Sell' &&
        data.sellerType in ['Resale', 'Builder', 'Landlord'] &&
        (data.expectedPrice is int || data.expectedPrice is float) && data.expectedPrice > 0 &&
        data.targetCategory == (data.sellerType == 'Builder' ? 'Primary' : 'Resale')) ||
       (data.willingTo == 'Rental' &&
        (data.rentPerMonth is int || data.rentPerMonth is float) && data.rentPerMonth > 0 &&
        data.maintenance is string && data.maintenance.size() <= 100 &&
        data.advance is string && data.advance.size() <= 100 &&
        data.availableFrom is string && data.availableFrom.size() <= 100 &&
        data.targetCategory == 'Rental')) &&
      data.propertyType in ['Apartment', 'Villa', 'Plot', 'Commercial'] &&
      data.societyType in ['Gated', 'Individual'] &&
      data.propertyStatus in ['Ready to Move', 'Under Construction', 'EOI', 'Nearing Completion'] &&
      data.configuration in ['Studio', '1 BHK', '2 BHK', '3 BHK', '4 BHK', '5 BHK'] &&
      data.doorFacing in ['East', 'North', 'West', 'South', 'South East', 'North East'] &&
      data.furnishing in ['Semi Furnished', 'Furnished', 'Unfurnished'] &&
      data.floorNumber is string && data.floorNumber.size() <= 100 &&
      data.towerNumber is string && data.towerNumber.size() <= 100 &&
      data.totalAcres is string && data.totalAcres.size() <= 100 &&
      data.amenities is list && data.amenities.size() <= 23 &&
      data.others is string && data.others.size() <= 10000 &&
      data.photos is list && data.photos.size() <= 25 &&
      (data.video == null || data.video is map) &&
      data.submissionStatus == 'Pending Review' &&
      data.isDeleted == false &&
      data.createdAt == request.time &&
      data.updatedAt == request.time &&
      existsAfter(/databases/$(database)/documents/public_portfolio/$(data.publicPortfolioId)) &&
      getAfter(/databases/$(database)/documents/public_portfolio/$(data.publicPortfolioId)).data.submissionId == submissionId;
    }

    function isSafePublicPortfolio(data, portfolioId) {
      return data.keys().hasAll([
        'id', 'submissionId', 'name', 'location', 'googleMapUrl', 'reraNumber',
        'category', 'propertyType', 'societyType', 'formattedPrice', 'propertyStatus',
        'possessionDate', 'configuration', 'doorFacing', 'floorNumber', 'towerNumber',
        'totalAcres', 'amenities', 'furnishing', 'others', 'mainImageUrl', 'imageUrls',
        'photoThumbnails', 'videoUrl', 'videoPosterUrl', 'storagePaths',
        'publicationStatus', 'isPublished', 'isDeleted', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'submissionId', 'name', 'location', 'publicAddressHint', 'googleMapUrl',
        'reraNumber', 'category', 'propertyType', 'societyType', 'sellerType',
        'expectedPrice', 'formattedPrice', 'rentPerMonth', 'maintenance', 'advance',
        'availableFrom', 'propertyStatus', 'possessionDate', 'configuration', 'doorFacing',
        'floorNumber', 'towerNumber', 'totalAcres', 'amenities', 'furnishing', 'others',
        'mainImageUrl', 'imageUrls', 'photoThumbnails', 'videoUrl', 'videoPosterUrl',
        'storagePaths', 'publicationStatus', 'isPublished', 'isDeleted', 'createdAt', 'updatedAt'
      ]) &&
      data.id == portfolioId &&
      data.submissionId is string &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
      data.location is string && data.location.size() <= 200 &&
      data.reraNumber is string && data.reraNumber.size() <= 150 &&
      data.category in ['Primary', 'Resale', 'Rental'] &&
      data.publicationStatus == 'Pending Review' &&
      data.isPublished == false && data.isDeleted == false &&
      data.createdAt == request.time && data.updatedAt == request.time &&
      existsAfter(/databases/$(database)/documents/property_submissions/$(data.submissionId)) &&
      getAfter(/databases/$(database)/documents/property_submissions/$(data.submissionId)).data.publicPortfolioId == portfolioId;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // Connectivity Test
    match /test/connection {
      allow read: if true;
    }

    // Projects: public read; all inventory writes are restricted to verified admins.
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      // Allow verified admins to archive legacy inventory records even when
      // older documents no longer satisfy today's full project schema. This
      // exception is deliberately limited to a one-way soft-delete flag and
      // server timestamp; it cannot edit listing content or unarchive records.
      allow update: if isAdmin() && isValidId(projectId) && (
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'updatedAt']) &&
          incoming().isDeleted == true &&
          incoming().updatedAt == request.time
        ) ||
        (
          // Visibility-only changes must remain possible for legacy inventory
          // documents that predate the current full project schema.
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isPaused', 'updatedAt']) &&
          incoming().isPaused is bool &&
          incoming().updatedAt == request.time &&
          (!('isDeleted' in existing()) || existing().isDeleted == false)
        ) ||
        (
          isValidProjectUpdate(incoming(), incoming().diff(existing()).affectedKeys()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'name', 'description', 'price', 'lastPrice', 'lastCheckedPrice', 'priceChanged', 'priceHistory',
            'location', 'locationTarget',
            'zone', 'type', 'propertyType', 'builderCategory', 'builderName',
            'approvalBody', 'floorPlan', 'floorPlanImageUrl',
            'configuration', 'segment', 'imageUrls', 'videoUrl',
            'features', 'handoverStatus', 'reraNumber', 'handoverDate', 'projectSize',
            'noOfTowers', 'flatsPerFloor', 'floorsHeight', 'mapUrl',
            'paymentOffers', 'isPaused', 'isDeleted', 'sticker',
            'availableFrom', 'mainDoorFacing', 'tower', 'floor', 'residenceType',
            'tenantType', 'amenitiesAvailability', 'petFriendly', 'furnishType',
            'advance', 'monthlyRental', 'maintenance', 'suba', 'carpetArea',
            'carCloseParking', 'balcony', 'comments', 'handedOverDate',
            'registrationStatus', 'approvedAuthority', 'seoKeywords', 'ogImage',
            'metaTitle', 'metaDescription', 'canonicalUrl',
            'imageAltText', 'imageAltTexts', 'seoTitle', 'seoDescription', 'seoLastSyncedAt', 'seoLastEdited', 'seoRevisions',
            'mobileImageUrl', 'mobileVideoUrl', 'unitsRemaining', 'isInventorySoldOut',
            'projectTypeCategory', 'presentStatus', 'vaastuCompliant', 'facingAvailable', 'floorRise', 'totalUnits',
            'floorPlanSize', 'bookingAmount', 'interiorStatus', 'availability', 'floorAvailability', 'saleFrom',
            'aop', 'expectedRentalIncome', 'terrace', 'garden', 'projectWriteUps',
            'organicViews', 'createdAt', 'updatedAt',
            'societyType', 'totalAcres', 'possessionDate', 'showImagesOnline',
            'videoPosterUrl', 'storagePaths', 'seoSyncSource', 'submissionId', 'publicationStatus'
          ])
        )
      );
      // Inventory removal must use the audited soft-archive workflow.
      allow delete: if false;
    }

    function isValidProject(data) {
      return isValidProjectIdentity(data) &&
             isValidProjectPricing(data) &&
             isValidProjectDetails(data) &&
             isValidProjectRental(data) &&
             isValidProjectSeo(data) &&
             isValidProjectMedia(data) &&
             isValidProjectCurator(data);
    }

    function isValidProjectIdentity(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.location is string && data.location.size() <= 200 &&
             (!('locationTarget' in data) || (data.locationTarget is string && data.locationTarget.size() <= 300)) &&
             (!('zone' in data) || data.zone in [
               'Whitefield', 'Hoskote', 'Varthur', 'Gunjur', 'Hosa Road', 'Kasavanahalli',
               'East Bangalore', 'Off Sarjapur Road', 'Sarjapur', 'Electronic City',
               'Marathalli', 'Bellandur', 'South East Bangalore', 'Bangalore East',
               'Bangalore North', 'Bangalore West', 'Bangalore South', 'Bangalore Central', 'All Zone'
             ]) &&
             data.type in ['Primary', 'Resale', 'Rental', 'Primary Sale'] &&
             (!('propertyType' in data) || data.propertyType in ['Apartment', 'Villa', 'Plot', 'Flat', 'Commercial', 'Stand Alone Building']) &&
             (!('builderCategory' in data) || data.builderCategory in ['A+', 'A', 'B', 'C']) &&
             (!('builderName' in data) || (data.builderName is string && data.builderName.size() <= 150)) &&
             (!('approvalBody' in data) || (data.approvalBody is string && data.approvalBody.size() <= 150)) &&
             (!('floorPlan' in data) || (data.floorPlan is string && data.floorPlan.size() <= 1000)) &&
             (!('floorPlanImageUrl' in data) || (data.floorPlanImageUrl is string && data.floorPlanImageUrl.size() <= 900000)) &&
             (!('configuration' in data) || (data.configuration is list && data.configuration.size() <= 20)) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('submissionId' in data) || (data.submissionId is string && data.submissionId.size() <= 128)) &&
             (!('publicationStatus' in data) || data.publicationStatus in ['Pending Review', 'Approved', 'Published', 'Rejected', 'Archived']);
    }

    function isValidProjectPricing(data) {
      return data.price is string && data.price.size() <= 150 &&
             (!('lastPrice' in data) || (data.lastPrice is string && data.lastPrice.size() <= 150)) &&
             (!('lastCheckedPrice' in data) || (data.lastCheckedPrice is string && data.lastCheckedPrice.size() <= 150)) &&
             (!('priceChanged' in data) || data.priceChanged is bool) &&
             (!('priceHistory' in data) || (data.priceHistory is list && data.priceHistory.size() <= 20)) &&
             (!('segment' in data) || (data.segment is string && data.segment.size() <= 100)) &&
             (!('paymentOffers' in data) || (data.paymentOffers is string && data.paymentOffers.size() <= 500)) &&
             (!('isPaused' in data) || data.isPaused is bool) &&
             (!('isDeleted' in data) || data.isDeleted is bool) &&
             (!('sticker' in data) || data.sticker in ['Sold Out', 'Rented Out', 'None']) &&
             (!('unitsRemaining' in data) || data.unitsRemaining is number) &&
             (!('isInventorySoldOut' in data) || data.isInventorySoldOut is bool) &&
             (!('organicViews' in data) || data.organicViews is number);
    }

    function isValidProjectDetails(data) {
      return (!('handoverStatus' in data) || (data.handoverStatus is string && data.handoverStatus.size() <= 100)) &&
             (!('reraNumber' in data) || (data.reraNumber is string && data.reraNumber.size() <= 150)) &&
             (!('handoverDate' in data) || (data.handoverDate is string && data.handoverDate.size() <= 100)) &&
             (!('projectSize' in data) || (data.projectSize is string && data.projectSize.size() <= 150)) &&
             (!('noOfTowers' in data) || (data.noOfTowers is string && data.noOfTowers.size() <= 100)) &&
             (!('flatsPerFloor' in data) || (data.flatsPerFloor is string && data.flatsPerFloor.size() <= 100)) &&
             (!('floorsHeight' in data) || (data.floorsHeight is string && data.floorsHeight.size() <= 100)) &&
             (!('mapUrl' in data) || (data.mapUrl is string && data.mapUrl.size() <= 1000)) &&
             (!('societyType' in data) || (data.societyType is string && data.societyType.size() <= 100)) &&
             (!('totalAcres' in data) || (data.totalAcres is string && data.totalAcres.size() <= 100)) &&
             (!('possessionDate' in data) || (data.possessionDate is string && data.possessionDate.size() <= 100)) &&
             (!('availableFrom' in data) || (data.availableFrom is string && data.availableFrom.size() <= 100)) &&
             (!('mainDoorFacing' in data) || (data.mainDoorFacing is string && data.mainDoorFacing.size() <= 100)) &&
             (!('tower' in data) || (data.tower is string && data.tower.size() <= 100)) &&
             (!('floor' in data) || (data.floor is string && data.floor.size() <= 100)) &&
             (!('residenceType' in data) || (data.residenceType is string && data.residenceType.size() <= 100));
    }

    function isValidProjectRental(data) {
      return (!('tenantType' in data) || (data.tenantType is string && data.tenantType.size() <= 100)) &&
             (!('amenitiesAvailability' in data) || (data.amenitiesAvailability is string && data.amenitiesAvailability.size() <= 100)) &&
             (!('petFriendly' in data) || (data.petFriendly is string && data.petFriendly.size() <= 100)) &&
             (!('furnishType' in data) || (data.furnishType is string && data.furnishType.size() <= 100)) &&
             (!('advance' in data) || (data.advance is string && data.advance.size() <= 100)) &&
             (!('monthlyRental' in data) || (data.monthlyRental is string && data.monthlyRental.size() <= 100)) &&
             (!('maintenance' in data) || (data.maintenance is string && data.maintenance.size() <= 100)) &&
             (!('suba' in data) || (data.suba is string && data.suba.size() <= 100)) &&
             (!('carpetArea' in data) || (data.carpetArea is string && data.carpetArea.size() <= 100)) &&
             (!('carCloseParking' in data) || (data.carCloseParking is string && data.carCloseParking.size() <= 100)) &&
             (!('balcony' in data) || (data.balcony is string && data.balcony.size() <= 100)) &&
             (!('comments' in data) || (data.comments is string && data.comments.size() <= 2000)) &&
             (!('handedOverDate' in data) || (data.handedOverDate is string && data.handedOverDate.size() <= 100)) &&
             (!('registrationStatus' in data) || (data.registrationStatus is string && data.registrationStatus.size() <= 100)) &&
             (!('approvedAuthority' in data) || (data.approvedAuthority is string && data.approvedAuthority.size() <= 100));
    }

    function isValidProjectSeo(data) {
      return (!('seoKeywords' in data) || (data.seoKeywords is list && data.seoKeywords.size() <= 30)) &&
             (!('metaTitle' in data) || (data.metaTitle is string && data.metaTitle.size() <= 300)) &&
             (!('metaDescription' in data) || (data.metaDescription is string && data.metaDescription.size() <= 1000)) &&
             (!('canonicalUrl' in data) || (data.canonicalUrl is string && data.canonicalUrl.size() <= 500)) &&
             (!('ogImage' in data) || (data.ogImage is string && data.ogImage.size() <= 900000)) &&
             (!('imageAltText' in data) || (data.imageAltText is string && data.imageAltText.size() <= 1000)) &&
             (!('imageAltTexts' in data) || data.imageAltTexts is map) &&
             (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 300)) &&
             (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 1000)) &&
             (!('seoLastSyncedAt' in data) || (data.seoLastSyncedAt is string && data.seoLastSyncedAt.size() <= 100)) &&
             (!('seoSyncSource' in data) || (data.seoSyncSource is string && data.seoSyncSource.size() <= 100)) &&
             (!('seoLastEdited' in data) || (data.seoLastEdited is string && data.seoLastEdited.size() <= 100)) &&
             (!('seoRevisions' in data) || (data.seoRevisions is list && data.seoRevisions.size() <= 50));
    }

    function isValidProjectMedia(data) {
      return (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 25)) &&
             (!('features' in data) || (data.features is list && data.features.size() <= 50)) &&
             (!('mobileImageUrl' in data) || (data.mobileImageUrl is string && data.mobileImageUrl.size() <= 900000)) &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 900000)) &&
             (!('mobileVideoUrl' in data) || (data.mobileVideoUrl is string && data.mobileVideoUrl.size() <= 900000)) &&
             (!('videoPosterUrl' in data) || (data.videoPosterUrl is string && data.videoPosterUrl.size() <= 900000)) &&
             (!('storagePaths' in data) || (data.storagePaths is list && data.storagePaths.size() <= 50)) &&
             (!('showImagesOnline' in data) || data.showImagesOnline is bool);
    }

    function isValidProjectCurator(data) {
      return (!('projectTypeCategory' in data) || (data.projectTypeCategory is string && data.projectTypeCategory.size() <= 100)) &&
             (!('presentStatus' in data) || (data.presentStatus is string && data.presentStatus.size() <= 100)) &&
             (!('vaastuCompliant' in data) || (data.vaastuCompliant is string && data.vaastuCompliant.size() <= 50)) &&
             (!('facingAvailable' in data) || data.facingAvailable is list || (data.facingAvailable is string && data.facingAvailable.size() <= 200)) &&
             (!('floorRise' in data) || (data.floorRise is string && data.floorRise.size() <= 150)) &&
             (!('totalUnits' in data) || (data.totalUnits is string && data.totalUnits.size() <= 150)) &&
             (!('floorPlanSize' in data) || (data.floorPlanSize is string && data.floorPlanSize.size() <= 500)) &&
             (!('bookingAmount' in data) || (data.bookingAmount is string && data.bookingAmount.size() <= 150)) &&
             (!('interiorStatus' in data) || (data.interiorStatus is string && data.interiorStatus.size() <= 100)) &&
             (!('availability' in data) || (data.availability is string && data.availability.size() <= 50)) &&
             (!('floorAvailability' in data) || (data.floorAvailability is string && data.floorAvailability.size() <= 100)) &&
             (!('saleFrom' in data) || (data.saleFrom is string && data.saleFrom.size() <= 100)) &&
             (!('aop' in data) || (data.aop is string && data.aop.size() <= 100)) &&
             (!('expectedRentalIncome' in data) || (data.expectedRentalIncome is string && data.expectedRentalIncome.size() <= 150)) &&
             (!('terrace' in data) || (data.terrace is string && data.terrace.size() <= 50)) &&
             (!('garden' in data) || (data.garden is string && data.garden.size() <= 50)) &&
             (!('projectWriteUps' in data) || (data.projectWriteUps is string && data.projectWriteUps.size() <= 5000));
    }

    // Only the additional Portfolio Curator fields need explicit update checks.
    // Existing fields remain protected by the admin-only gate and changed-key allowlist.
    // Full schema validation still applies to every new project document.
    function isValidProjectUpdate(data, changed) {
      return (!changed.hasAny(['societyType']) ||
                ('societyType' in data && data.societyType is string && data.societyType.size() <= 100)) &&
             (!changed.hasAny(['totalAcres']) ||
                ('totalAcres' in data && data.totalAcres is string && data.totalAcres.size() <= 100)) &&
             (!changed.hasAny(['possessionDate']) ||
                ('possessionDate' in data && data.possessionDate is string && data.possessionDate.size() <= 100)) &&
             (!changed.hasAny(['showImagesOnline']) ||
                ('showImagesOnline' in data && data.showImagesOnline is bool)) &&
             (!changed.hasAny(['videoPosterUrl']) ||
                ('videoPosterUrl' in data && data.videoPosterUrl is string && data.videoPosterUrl.size() <= 900000)) &&
             (!changed.hasAny(['storagePaths']) ||
                ('storagePaths' in data && data.storagePaths is list && data.storagePaths.size() <= 50)) &&
             (!changed.hasAny(['seoSyncSource']) ||
                ('seoSyncSource' in data && data.seoSyncSource is string && data.seoSyncSource.size() <= 100)) &&
             (!changed.hasAny(['submissionId']) ||
                ('submissionId' in data && data.submissionId is string && data.submissionId.size() <= 128)) &&
             (!changed.hasAny(['publicationStatus']) ||
                ('publicationStatus' in data && data.publicationStatus in ['Pending Review', 'Approved', 'Published', 'Rejected', 'Archived']));
    }

    // Enquiries: Publicly writable (create only), admin readable
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && isValidEnquiry(incoming());
      allow read, update, delete: if isAdmin();
    }

    function isValidEnquiry(data) {
      return data.customerName is string &&
             data.customerName.size() >= 2 &&
             data.customerName.size() <= 100 &&
             data.customerPhone is string &&
             data.customerPhone.size() >= 8 &&
             data.customerPhone.size() <= 20 &&
             data.projectName is string &&
             data.projectName.size() <= 200 &&
             data.projectId is string &&
             data.projectId.size() <= 128 &&
             (!('interestedProjects' in data) || (data.interestedProjects is string && data.interestedProjects.size() <= 300)) &&
             (!('preferredLocation' in data) || (data.preferredLocation is string && data.preferredLocation.size() <= 200)) &&
             data.type in ['WhatsApp', 'Email', 'Form', 'AI Chat', 'Download Brochure', 'Site Visit'];
     }

    // Opportunities: Publicly writable (create only), admin readable
    match /opportunities/{opportunityId} {
      allow create: if isValidId(opportunityId) && isValidOpportunity(incoming());
      allow read, update, delete: if isAdmin();
    }

    function isValidOpportunity(data) {
      return data.name is string &&
             data.name.size() >= 2 &&
             data.name.size() <= 100 &&
             data.mobile is string &&
             data.mobile.size() >= 8 &&
             data.mobile.size() <= 25 &&
             (
               // Property Opportunity
               (
                 data.propertyName is string &&
                 data.propertyName.size() >= 2 &&
                 data.propertyName.size() <= 200 &&
                 data.propertyStatus in ['Ready to Move', 'Under Construction', 'On Going', 'Nearing Completion'] &&
                 data.propertyType in ['Villa', 'Flat', 'Plot'] &&
                 data.rooms in ['1BHK', '2BHK', '3BHK', '4BHK', '5BHK'] &&
                 data.facing is string &&
                 data.facing.size() >= 2 &&
                 data.facing.size() <= 100 &&
                 (!('tower' in data) || (data.tower is string && data.tower.size() <= 100)) &&
                 data.floorNumber is string &&
                 data.floorNumber.size() <= 50 &&
                 data.willingTo in ['Rent', 'Sell'] &&
                 (!('expectedRent' in data) || data.expectedRent is int || data.expectedRent is float) &&
                 (!('expectedSell' in data) || data.expectedSell is int || data.expectedSell is float) &&
                 (!('notes' in data) || (data.notes is string && data.notes.size() <= 1200))
               ) ||
               // Grow Business Opportunity
               (
                 (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
                 (!('interested' in data) || (data.interested is string && data.interested.size() <= 500)) &&
                 (!('services' in data) || (data.services is list && data.services.size() <= 10)) &&
                 (!('comment' in data) || (data.comment is string && data.comment.size() <= 1200)) &&
                 (!('category' in data) || data.category in ['Opportunity', 'Business', 'Property'])
               )
             );
    }

    // Subscriptions: Public writable, admin readable/manageable
    match /subscriptions/{subscriptionId} {
      allow create: if isValidId(subscriptionId) && isValidSubscription(incoming());
      allow read, update, delete: if isAdmin();
    }

    function isValidSubscription(data) {
      return data.email is string &&
             data.email.size() >= 5 &&
             data.email.size() <= 100 &&
             data.projectId is string &&
             data.projectName is string &&
             data.createdAt == request.time &&
             exists(/databases/$(database)/documents/projects/$(data.projectId));
    }


    // Private owner submissions: public create only; admin-only read and workflow updates.
    match /property_submissions/{submissionId} {
      allow create: if isValidId(submissionId) &&
        isValidPropertySubmission(request.resource.data, submissionId);
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'submissionStatus', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]) &&
        request.resource.data.submissionStatus in ['Approved', 'Published', 'Rejected', 'Archived'] &&
        request.resource.data.reviewedBy is string &&
        request.resource.data.reviewedBy.size() <= 200 &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Public-safe portfolio records: visitors can read published, non-deleted records only.
    // The public submission batch may create a pending sanitized record, never update/delete it.
    match /public_portfolio/{portfolioId} {
      allow read: if isAdmin() ||
        (resource.data.publicationStatus == 'Published' &&
         resource.data.isPublished == true &&
         resource.data.isDeleted == false);
      allow create: if isValidId(portfolioId) &&
        isSafePublicPortfolio(request.resource.data, portfolioId);
      allow update: if isAdmin() && (
        (
          // Legacy public portfolio records may not contain today's required
          // display fields. Permit only the irreversible archive transition.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'publicationStatus', 'isPublished', 'isDeleted', 'updatedAt'
          ]) &&
          request.resource.data.publicationStatus == 'Archived' &&
          request.resource.data.isPublished == false &&
          request.resource.data.isDeleted == true &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          // Hide/unhide is a narrow workflow transition. Permit it on legacy
          // records even when unrelated display fields are incomplete.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'publicationStatus', 'isPublished', 'isDeleted', 'updatedAt'
          ]) &&
          request.resource.data.publicationStatus in ['Approved', 'Published'] &&
          request.resource.data.isPublished == (request.resource.data.publicationStatus == 'Published') &&
          request.resource.data.isDeleted == false &&
          request.resource.data.updatedAt == request.time
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'publicationStatus', 'isPublished', 'isDeleted', 'updatedAt',
            'name', 'location', 'category', 'propertyType', 'possessionDate', 'formattedPrice', 'expectedPrice', 'rentPerMonth',
            'propertyStatus', 'doorFacing', 'furnishing', 'societyType', 'sellerType', 'others',
            'configuration', 'amenities', 'imageUrls', 'mainImageUrl', 'videoUrl', 'googleMapUrl',
            'reraNumber', 'totalAcres', 'floorNumber', 'towerNumber', 'maintenance', 'advance',
            'availableFrom', 'projectTypeCategory', 'presentStatus', 'vaastuCompliant',
            'facingAvailable', 'floorRise', 'totalUnits', 'floorPlanSize', 'bookingAmount',
            'interiorStatus', 'availability', 'floorAvailability', 'saleFrom', 'aop',
            'expectedRentalIncome', 'terrace', 'garden', 'projectWriteUps'
          ]) &&
          request.resource.data.publicationStatus in ['Pending Review', 'Approved', 'Published', 'Rejected', 'Archived'] &&
          request.resource.data.isPublished == (request.resource.data.publicationStatus == 'Published') &&
          request.resource.data.isDeleted is bool &&
          (!request.resource.data.isDeleted ||
            (request.resource.data.publicationStatus == 'Archived' && request.resource.data.isPublished == false)) &&
          request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
          request.resource.data.location is string && request.resource.data.location.size() <= 200 &&
          request.resource.data.formattedPrice is string && request.resource.data.formattedPrice.size() <= 150 &&
          request.resource.data.category in ['Primary', 'Resale', 'Rental'] &&
          (!('propertyType' in request.resource.data) || request.resource.data.propertyType in ['Apartment', 'Villa', 'Plot', 'Commercial']) &&
          (!('possessionDate' in request.resource.data) || (request.resource.data.possessionDate is string && request.resource.data.possessionDate.size() <= 100)) &&
          (!('societyType' in request.resource.data) || request.resource.data.societyType in ['Gated', 'Individual']) &&
          (!('sellerType' in request.resource.data) || request.resource.data.sellerType in ['Resale', 'Builder', 'Landlord']) &&
          (!('furnishing' in request.resource.data) || request.resource.data.furnishing in ['Semi Furnished', 'Furnished', 'Unfurnished']) &&
          (!('propertyStatus' in request.resource.data) || request.resource.data.propertyStatus in ['Ready to Move', 'Under Construction', 'EOI', 'Nearing Completion']) &&
          request.resource.data.updatedAt == request.time
        )
      );
      allow delete: if false;
    }

    // Referrals: Publicly writable (create only), admin readable
    match /referrals/{referralId} {
      allow create: if isValidId(referralId) && isValidReferral(incoming());
      allow read, update, delete: if isAdmin();
    }

    function isValidReferral(data) {
      return data.name is string &&
             data.name.size() >= 2 &&
             data.name.size() <= 100 &&
             data.mobileNumber is string &&
             data.mobileNumber.size() >= 8 &&
             data.mobileNumber.size() <= 20 &&
             data.budget is string &&
             data.location is string &&
             data.propertyType in ['Villa', 'Flat', 'Plot', 'Stand Alone Building'] &&
             data.unitType in ['1BHK', '2BHK', '3BHK', '4BHK', '5BHK'] &&
             data.contactDateTime is string &&
             data.whatsappNumber is string &&
             data.lookingFor in ['New Building', 'Resale'] &&
             (!('resaleAge' in data) || data.resaleAge is string) &&
             (!('referrerName' in data) || data.referrerName is string) &&
             (!('referrerContact' in data) || data.referrerContact is string) &&
             (!('clientOpinion' in data) || data.clientOpinion is string);
    }
  }
}
