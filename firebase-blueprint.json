{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Real estate project listing",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Project name" },
        "description": { "type": "string", "description": "Short description / writeup" },
        "price": { "type": "string", "description": "Price range" },
        "location": { "type": "string", "description": "Micro-location name" },
        "locationTarget": { "type": "string", "description": "Specific landmark or target area" },
        "zone": { "type": "string", "enum": ["Whitefield", "Hoskote", "Varthur", "Gunjur", "Hosa Road", "Kasavanahalli", "East Bangalore", "Off Sarjapur Road", "Sarjapur", "Electronic City", "Marathalli", "Bellandur", "South East Bangalore", "Bangalore East", "Bangalore North", "Bangalore West", "Bangalore South", "Bangalore Central", "All Zone"], "description": "Market zone in Bangalore" },
        "type": { "type": "string", "enum": ["Primary", "Resale", "Rental", "Primary Sale"], "description": "Type of portfolio (Primary, Resale, Rental)" },
        "propertyType": { "type": "string", "enum": ["Apartment", "Villa", "Plot", "Flat", "Commercial", "Stand Alone Building"], "description": "Type of property" },
        "builderCategory": { "type": "string", "enum": ["A+", "A", "B", "C"], "description": "Builder tier category" },
        "builderName": { "type": "string", "description": "Name of developer / builder" },
        "approvalBody": { "type": "string", "description": "Statutory approval body (BBMP, BDA, BMRDA, STRR, BIAPA, DTCP)" },
        "floorPlan": { "type": "string", "description": "Floor plan specifications and SBA/Carpet area details" },
        "floorPlanImageUrl": { "type": "string", "description": "Optional floor plan image URL" },
        "configuration": { "type": "array", "items": { "type": "string" }, "description": "Available configurations" },
        "segment": { "type": "string", "description": "Luxury, Premium, Budget, etc." },
        "handoverStatus": { "type": "string", "enum": ["EOI", "Under Construction", "Ready to Move", "Handed Over", "Nearing Completion", "Prelaunch", "Official Launch"], "description": "Construction / handover status" },
        "reraNumber": { "type": "string", "description": "RERA Registration Number" },
        "handoverDate": { "type": "string", "description": "Expected or completed Hand Over Date" },
        "projectSize": { "type": "string", "description": "Total project land area and unit count" },
        "noOfTowers": { "type": "string", "description": "Number of residential towers" },
        "flatsPerFloor": { "type": "string", "description": "Number of flats per floor" },
        "floorsHeight": { "type": "string", "description": "Number of floors / building height" },
        "mapUrl": { "type": "string", "description": "Google Maps embed or location URL" },
        "paymentOffers": { "type": "string", "description": "Payment offers text" },
        "imageUrls": { "type": "array", "items": { "type": "string" }, "description": "Gallery images" },
        "mobileImageUrl": { "type": "string", "description": "Gallery image optimal for mobile view" },
        "videoUrl": { "type": "string", "description": "YouTube or Drive video link" },
        "mobileVideoUrl": { "type": "string", "description": "Gallery video optimal for mobile view" },
        "features": { "type": "array", "items": { "type": "string" }, "description": "Key amenities" },
        "priceChanged": { "type": "boolean", "description": "Flag indicating a significant price change" },
        "lastCheckedPrice": { "type": "string", "description": "The price at the last check" },
        "lastPrice": { "type": "string", "description": "Last verified price" },
        "isPaused": { "type": "boolean", "description": "Flag to temporarily unpublish the project from visitor feeds" },
        "sticker": { "type": "string", "enum": ["Sold Out", "Rented Out", "None"], "description": "Status sticker label" },
        "availableFrom": { "type": "string", "description": "Availability date for rental or resale" },
        "mainDoorFacing": { "type": "string", "description": "Vaastu door facing direction" },
        "tower": { "type": "string", "description": "Building block or tower" },
        "floor": { "type": "string", "description": "Floor number or range" },
        "residenceType": { "type": "string", "description": "BHK or unit type" },
        "tenantType": { "type": "string", "description": "Preferred tenant profile" },
        "amenitiesAvailability": { "type": "string", "description": "Access to clubhouse and amenities" },
        "petFriendly": { "type": "string", "description": "Pet policy" },
        "furnishType": { "type": "string", "description": "Furnishing level" },
        "advance": { "type": "string", "description": "Security deposit / advance" },
        "monthlyRental": { "type": "string", "description": "Monthly rent amount" },
        "maintenance": { "type": "string", "description": "Monthly society maintenance" },
        "suba": { "type": "string", "description": "Super built-up area" },
        "carpetArea": { "type": "string", "description": "Carpet area in sq.ft." },
        "carCloseParking": { "type": "string", "description": "Covered parking slots" },
        "balcony": { "type": "string", "description": "Number of balconies" },
        "comments": { "type": "string", "description": "Specific landlord or owner notes" },
        "handedOverDate": { "type": "string", "description": "Possession handover date" },
        "registrationStatus": { "type": "string", "description": "Legal deed registration status" },
        "approvedAuthority": { "type": "string", "description": "Planning authority approval" },
        "seoKeywords": { "type": "array", "items": { "type": "string" }, "description": "SEO keywords" },
        "ogImage": { "type": "string", "description": "Social share preview card image" },
        "imageAltText": { "type": "string", "description": "Accessible primary image alt text" },
        "imageAltTexts": { "type": "object", "description": "Dictionary of image URLs to custom alt text" },
        "metaTitle": { "type": "string", "description": "SEO Meta Title" },
        "metaDescription": { "type": "string", "description": "SEO Meta Description" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "location", "type"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Customer enquiry or brochure download request for a project",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "interestedProjects": { "type": "string" },
        "preferredLocation": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["WhatsApp", "Email", "Form", "AI Chat", "Download Brochure", "Site Visit"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerPhone", "projectName"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "User property or grow business opportunity lead submitted via website",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "interested": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" } },
        "comment": { "type": "string" },
        "category": { "type": "string", "enum": ["Business", "Property"] },
        "propertyName": { "type": "string" },
        "propertyStatus": { "type": "string", "enum": ["Ready to Move", "Under Construction", "On Going", "Nearing Completion"] },
        "propertyType": { "type": "string", "enum": ["Villa", "Flat", "Plot"] },
        "rooms": { "type": "string", "enum": ["1BHK", "2BHK", "3BHK", "4BHK", "5BHK"] },
        "facing": { "type": "string" },
        "tower": { "type": "string" },
        "floorNumber": { "type": "string" },
        "willingTo": { "type": "string", "enum": ["Rent", "Sell"] },
        "expectedRent": { "type": "number" },
        "expectedSell": { "type": "number" },
        "notes": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Subscription for price changes on a property",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "description": "ID of the target property/project" },
        "projectName": { "type": "string", "description": "Name of the target property/project" },
        "email": { "type": "string", "description": "Subscribed email address" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "projectName", "email"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Referral registry for friends & family purchasing properties",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Referred friend or family member name" },
        "mobileNumber": { "type": "string", "description": "Contact number" },
        "budget": { "type": "string", "description": "Price range (Min to Max)" },
        "location": { "type": "string", "description": "Target location" },
        "propertyType": { "type": "string", "enum": ["Villa", "Flat", "Plot", "Stand Alone Building"] },
        "unitType": { "type": "string", "enum": ["1BHK", "2BHK", "3BHK", "4BHK", "5BHK"] },
        "contactDateTime": { "type": "string", "description": "Preferred time and date to connect" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp contact" },
        "lookingFor": { "type": "string", "enum": ["New Building", "Resale"] },
        "resaleAge": { "type": "string", "description": "Age of property if Resale selected" },
        "referrerName": { "type": "string", "description": "Person making the referral" },
        "referrerContact": { "type": "string", "description": "Contact information (email or phone) of referrer" },
        "clientOpinion": { "type": "string", "description": "Additional notes or description" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobileNumber", "budget", "location", "propertyType", "unitType", "contactDateTime", "whatsappNumber", "lookingFor"]
    }
  },
  "firestore": {
    "projects": {
      "schema": "Project",
      "description": "Collection of real estate projects"
    },
    "enquiries": {
      "schema": "Enquiry",
      "description": "Customer enquiries submitted via the website"
    },
    "opportunities": {
      "schema": "Opportunity",
      "description": "Opportunities submitted by users to sell or rent properties"
    },
    "subscriptions": {
      "schema": "Subscription",
      "description": "Subscriptions for price updates on real estate listings"
    },
    "referrals": {
      "schema": "Referral",
      "description": "Referrals submitted by users for friends and family"
    }
  }
}
