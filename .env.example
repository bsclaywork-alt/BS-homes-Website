# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Google Drive Integration
GOOGLE_DRIVE_FOLDER_ID="YOUR_FOLDER_ID_HERE"
# Optional: Path to Google Service Account JSON if using private drive
GOOGLE_APPLICATION_CREDENTIALS="path/to/credentials.json"

GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Direct Email Alert Configuration for Enquiries (sent to contact@bshomez.in)
# Set your SMTP credentials (e.g. Google Workspace / Gmail App Password, Resend, SendGrid, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="contact@bshomez.in"
SMTP_PASS="YOUR_APP_PASSWORD_OR_SMTP_KEY"
SMTP_FROM="BS Homez Enquiries <contact@bshomez.in>"
ALERT_RECIPIENT_EMAIL="contact@bshomez.in"
